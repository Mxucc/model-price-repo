    "deepseek-flash": {
      "_comment": "DeepSeek-V4.1-Flash, the current model name. Official card (api-docs.deepseek.com/zh-cn/quick_start/pricing) 2026-09-22: two live models, deepseek-flash (V4.1-Flash) and deepseek-v4-pro (V4-Pro-0813); peak = Beijing Mon-Fri 09:00-12:00 & 14:00-18:00, off-peak is exactly half. CNY card converted at the rate sub2api has always billed: flash 1/4/0.02 CNY per MTok -> 0.15/0.60/0.003 USD, pro 4.5/13.5/0.15 -> 0.66/1.98/0.022. The unit rates below are the OFF-PEAK baseline so the price page shows the same numbers the off_peak tier charges; the peak is carried by billing_expr, which is the only thing that prices a request. Keep billing_expr's trailing ' + cc * 0 + cc1h * 0' -- a cache-write variable the expression never mentions stays inside `p` and would be billed at the input rate.",
      "litellm_provider": "deepseek",
      "mode": "chat",
      "input_cost_per_token": 1.5e-07,
      "output_cost_per_token": 6e-07,
      "cache_read_input_token_cost": 3e-09,
      "cache_creation_input_token_cost": 0,
      "cache_creation_input_token_cost_above_1hr": 0,
      "billing_expr": "v1:weekday(\"Asia/Shanghai\") >= 1 && weekday(\"Asia/Shanghai\") <= 5 && ((hour(\"Asia/Shanghai\") >= 9 && hour(\"Asia/Shanghai\") < 12) || (hour(\"Asia/Shanghai\") >= 14 && hour(\"Asia/Shanghai\") < 18)) ? tier(\"peak\", p * 0.30 + cr * 0.006 + c * 1.20 + cc * 0 + cc1h * 0) : tier(\"off_peak\", p * 0.15 + cr * 0.003 + c * 0.60 + cc * 0 + cc1h * 0)"
    },
